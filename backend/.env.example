# ========================
# Base de datos PostgreSQL
# ========================
POSTGRES_USER=banex_user
POSTGRES_PASSWORD=banex_pass
POSTGRES_DB=banex_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://banex_user:banex_pass@postgres:5432/banex_db

# ========================
# Redis
# ========================
REDIS_URL=redis://redis:6379/0

# ========================
# JWT / Seguridad
# ========================
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================
# Entorno
# ========================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ========================
# CORS
# ========================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
